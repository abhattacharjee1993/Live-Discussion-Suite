      --ag-r2-f: 18px; --ag-r2-c: #ffffff; --ag-r2-bg: #111; --ag-b2-c: #111; --ag-b2-bg: #ffd700;
      --ag-r3-f: 16px; --ag-r3-c: #aaaaaa; --ag-r3-bg: #111; --ag-b3-c: #fff; --ag-b3-bg: #3b82f6;

      --ff-l3: 'Montserrat', sans-serif;
      --l3-f-name: 26px; --l3-f-title: 14px;
      
      --br-w: 8px; --br-op: 1; --br-style: linear-gradient(135deg, #d31122 0%, #f6b200 100%);
      
      --lss-scale: 1; --lss-x: 50%; --lss-y: 20%; --lss-bg: linear-gradient(90deg, #ff0000 0%, #cc0000 100%); --lss-txt: #ffffff;
      
      --agl-scale: 1; --agl-x: 80%; --agl-y: 50%; --agl-bg: linear-gradient(135deg, #111 0%, #222 100%); --agl-txt: #ffffff;
      
      /* Custom List Variables */
      --clp-scale: 1; --clp-x: 20%; --clp-y: 50%; --clp-bg: linear-gradient(135deg, #111 0%, #222 100%); --clp-txt: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    html, body { background-color: transparent !important; background-image: none !important; font-family: 'Montserrat', sans-serif; overflow: hidden; width: 100vw; height: 100vh; position: relative; }
    img[src=""], img:not([src]) { display: none !important; }
    .font-dropdown, .font-select { background: #222; color: #ccc; border: 1px solid #555; border-radius: 4px; padding: 2px 4px; width: 90px; font-family: 'Montserrat', sans-serif; cursor: pointer; outline: none; font-size: 11px; font-weight: bold; }

    /* BORDERS */
    .cam-frame { position: absolute; display: none; aspect-ratio: 16/9; pointer-events: none; border: var(--br-w) solid; border-image: var(--br-style) 1; opacity: var(--br-op); z-index: 1; box-shadow: inset 0 0 20px rgba(0,0,0,0.5), 0 0 20px rgba(0,0,0,0.5); }
