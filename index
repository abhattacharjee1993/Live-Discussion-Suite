        document.getElementById('tgt-vis').checked = state.tgtVis; document.getElementById('tgt-like').value = state.tgtLike; document.getElementById('tgt-sub').value = state.tgtSub; document.getElementById('tgt-scale').value = state.tgtScale; document.getElementById('ff-tgt-lbl').value = state.ffTgtLbl; document.getElementById('tgt-f-lbl').value = state.fTgtLbl; document.getElementById('ff-tgt-val').value = state.ffTgtVal; document.getElementById('tgt-f-val').value = state.fTgtVal; document.getElementById('tgt-style').value = state.tgtStyle; document.getElementById('tgt-c1').value = state.tgtC1; document.getElementById('tgt-c2').value = state.tgtC2;
        
        if (forceRebuildControls) renderControls();
      }

      // Update Overlay DOM
      document.getElementById('agenda-wrapper').style.display = state.agVis ? 'flex' : 'none';
      document.getElementById('ag-row-1').textContent = state.agR1Txt; document.getElementById('ag-text-2').textContent = state.agR2Txt; document.getElementById('ag-text-3').textContent = state.agR3Txt;
      
      document.getElementById('agl-wrapper').style.display = state.aglVis ? 'flex' : 'none';
      document.getElementById('agl-title-display').textContent = state.aglTitle;
      
      // Vertical Agenda Mapping with Live Bulb, Up Next, and Completed
      document.getElementById('agl-list-render').innerHTML = state.agendaItems.map(i => {
        let pre = i.status === 'now' ? '<div class="ag-live-bulb"></div>' : '';
        let post = i.status === 'next' ? '<div class="ag-up-next">UP NEXT</div>' : (i.status === 'completed' ? '<div class="ag-completed">✔</div>' : '');
        return `<div class="agl-item status-${i.status}">${pre}<span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${i.text}</span>${post}</div>`;
      }).join('');
      attachDraggable(document.getElementById('agl-wrapper'), (x, y) => { state.aglX = x; state.aglY = y; });

      document.getElementById('clp-wrapper').style.display = state.clpVis ? 'flex' : 'none';
      document.getElementById('clp-title-display').textContent = state.clpTitle;
      document.getElementById('clp-list-render').innerHTML = (state.clpItems || []).map(i => {
        let styleStr = i.hl ? `border-left-color: ${i.hlC}; background: ${i.hlC}33; color: ${i.hlC};` : '';
        return `<div class="clp-item ${i.hl ? 'highlighted' : ''}" style="${styleStr}">${i.text}</div>`;
      }).join('');
      attachDraggable(document.getElementById('clp-wrapper'), (x, y) => { state.clpX = x; state.clpY = y; });

      document.getElementById('overlay-nameplates').innerHTML = state.nameplates.map(np => 
        np.vis ? `<div class="nameplate-wrapper" id="np-overlay-${np.id}" style="left:${np.x}%; top:${np.y}%;"><div class="np-top" style="color:${np.txtNameC}; background:${getGrad(np.style, np.c1, np.c2)};">${np.name}</div><div class="np-bottom" style="color:${np.txtTitleC}; background:${getGrad(np.titleStyle, np.titleBg1, np.titleBg2)};">${np.title}</div></div>` : ''
      ).join('');
      state.nameplates.forEach(np => {
        const el = document.getElementById(`np-overlay-${np.id}`);
        if(el) attachDraggable(el, (x, y) => { np.x = x; np.y = y; });
      });

      document.getElementById('lss-widget').style.display = state.lssVis ? 'flex' : 'none';
      document.getElementById('lss-widget').className = state.lssAnim ? 'lss-wrapper lss-animated' : 'lss-wrapper';
      attachDraggable(document.getElementById('lss-widget'), (x, y) => { state.lssX = x; state.lssY = y; });

      document.getElementById('ticker-wrapper').style.display = state.tkVis ? 'flex' : 'none';
      document.getElementById('ticker-text').textContent = state.tkTxt; document.getElementById('ticker-text').className = state.tkScroll ? 'ticker-text scrolling' : 'ticker-text static';

      document.getElementById('global-frame').style.display = state.brVis ? 'block' : 'none';
      
      document.getElementById('targets-wrapper').style.display = state.tgtVis ? 'flex' : 'none';
      document.getElementById('like-target-display').textContent = state.tgtLike; document.getElementById('sub-target-display').textContent = state.tgtSub;

      applyCSSVars();
    }

    function renderControls() {
      if(isOverlay) return;
      document.getElementById('agl-controls-container').innerHTML = state.agendaItems.map(i => `
        <div style="display:flex; gap:6px; align-items:center;">
          <input type="text" class="auto-text" id="agl-txt-${i.id}" value="${i.text}" style="flex:1;" oninput="applyInstant()">
          <button class="ctrl-btn ${i.status==='now'?'highlight':''}" onclick="setAgendaStatus(${i.id}, 'now')">${i.status==='now'?'Unset Now':'Set Now'}</button>
          <button class="ctrl-btn ${i.status==='next'?'special':''}" onclick="setAgendaStatus(${i.id}, 'next')">${i.status==='next'?'Unset Next':'Set Next'}</button>
          <button class="ctrl-btn ${i.status==='completed'?'warning':''}" onclick="setAgendaStatus(${i.id}, 'completed')" style="background:${i.status==='completed'?'#10b981':''}; border-color:${i.status==='completed'?'#059669':''}">${i.status==='completed'?'Unmark Done':'Mark Done'}</button>
          <button class="ctrl-btn warning" onclick="removeAgendaItem(${i.id})">X</button>
        </div>
      `).join('');

      document.getElementById('clp-controls-container').innerHTML = (state.clpItems || []).map(i => `
        <div style="display:flex; gap:6px; align-items:center;">
          <input type="text" class="auto-text" id="clp-txt-${i.id}" value="${i.text}" style="flex:1;" oninput="applyInstant()">
          <input type="color" id="clp-c-${i.id}" value="${i.hlC}" oninput="applyInstant()" style="width:24px; height:24px; padding:0; border:none; cursor:pointer;" title="Highlight Color">
          <button class="ctrl-btn ${i.hl?'highlight':''}" onclick="toggleClpHighlight(${i.id})">${i.hl?'Unhighlight':'Highlight'}</button>
          <button class="ctrl-btn warning" onclick="removeClpItem(${i.id})">X</button>
        </div>
      `).join('');

      document.getElementById('nameplate-controls-container').innerHTML = state.nameplates.map(np => `
        <div style="background:rgba(0,0,0,0.3); padding:10px; border:1px solid #444; border-radius:6px;">
          <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
            <label style="font-weight:bold;"><input type="checkbox" id="np-vis-${np.id}" ${np.vis?'checked':''} onchange="applyInstant()"> Show</label>
            <button class="ctrl-btn warning" style="padding:2px 8px; font-size:10px;" onclick="removeNameplate(${np.id})">Delete</button>
          </div>
          <div style="display:flex; gap:6px; margin-bottom:8px;">
            <input type="text" class="auto-text" id="np-name-${np.id}" value="${np.name}" placeholder="Name" oninput="applyInstant()">
            <input type="text" class="auto-text" id="np-title-${np.id}" value="${np.title}" placeholder="Title" oninput="applyInstant()">
          </div>
          <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:8px;">
            <span style="font-size:10px; font-weight:bold; color:#ccc;">NAME BG:</span> 
            <input type="range" id="np-scale-${np.id}" min="0.5" max="2" step="0.05" value="${np.scale}" style="width:50px;" oninput="applyVisualsLocally()">
            <select id="np-style-${np.id}" class="font-select" onchange="applyVisualsLocally()"><option value="solid" ${np.style==='solid'?'selected':''}>Solid</option><option value="split" ${np.style==='split'?'selected':''}>Split</option><option value="gradient" ${np.style==='gradient'?'selected':''}>Grad</option></select>
            <input type="color" id="np-c1-${np.id}" value="${np.c1}" oninput="applyVisualsLocally()" style="width:24px; height:24px;">
            <input type="color" id="np-c2-${np.id}" value="${np.c2}" oninput="applyVisualsLocally()" style="width:24px; height:24px;">
            
            <span style="font-size:10px; font-weight:bold; color:#ccc; margin-left:10px;">NAME TEXT C:</span>
            <input type="color" id="np-txt-name-c-${np.id}" value="${np.txtNameC}" oninput="applyVisualsLocally()" style="width:24px; height:24px;" title="Name Text Color">
            
            <span style="font-size:10px; font-weight:bold; color:#ccc; margin-left:10px;">TITLE TEXT C:</span>
            <input type="color" id="np-txt-title-c-${np.id}" value="${np.txtTitleC}" oninput="applyVisualsLocally()" style="width:24px; height:24px;" title="Title Text Color">
            
            <span style="font-size:10px; font-weight:bold; color:#ccc; margin-left:10px;">TITLE BG:</span>
            <select id="np-title-style-${np.id}" class="font-select" onchange="applyVisualsLocally()"><option value="solid" ${np.titleStyle==='solid'?'selected':''}>Solid</option><option value="split" ${np.titleStyle==='split'?'selected':''}>Split</option><option value="gradient" ${np.titleStyle==='gradient'?'selected':''}>Grad</option></select>
            <input type="color" id="np-title-bg1-${np.id}" value="${np.titleBg1}" oninput="applyVisualsLocally()" style="width:24px; height:24px;">
            <input type="color" id="np-title-bg2-${np.id}" value="${np.titleBg2}" oninput="applyVisualsLocally()" style="width:24px; height:24px;">
          </div>
        </div>
      `).join('');
    }

    // --- PRESETS & LAYOUTS ---
    let borderPresets = {};
    const defaultBorderPresets = {
      'East Bengal Split': { w:8, op:1, style:'split', c1:'#d31122', c2:'#f6b200' },
      'Cyber Gradient': { w:12, op:1, style:'gradient', c1:'#06b6d4', c2:'#9333ea' },
      'Solid White Thin': { w:4, op:0.8, style:'solid', c1:'#ffffff', c2:'#ffffff' },
      'Neon Blue': { w:8, op:1, style:'gradient', c1:'#00f2fe', c2:'#4facfe' },
      'Crimson Force': { w:10, op:1, style:'split', c1:'#ff0844', c2:'#ffb199' },
      'Emerald Outline': { w:6, op:0.9, style:'solid', c1:'#10b981', c2:'#10b981' },
      'Royal Purple': { w:12, op:1, style:'gradient', c1:'#667eea', c2:'#764ba2' },
      'Sunset Orange': { w:8, op:1, style:'gradient', c1:'#ff9a9e', c2:'#fecfef' },
      'Monochrome Tech': { w:10, op:1, style:'split', c1:'#333333', c2:'#aaaaaa' },
      'Gold Split': { w:8, op:1, style:'split', c1:'#ffd700', c2:'#b8860b' }
    };

    function initBorderPresets() {
      const stored = localStorage.getItem('suiBorderPresetsV5');
      borderPresets = stored ? JSON.parse(stored) : defaultBorderPresets;
      updatePresetDropdown();
    }
    function updatePresetDropdown() {
      const sel = document.getElementById('br-preset-sel'); sel.innerHTML = '<option value="">Presets...</option>';
      Object.keys(borderPresets).forEach(k => { sel.innerHTML += `<option value="${k}">${k}</option>`; });
    }
    function saveBorderPreset() {
      const name = prompt("Name this preset:"); if(!name) return;
      borderPresets[name] = { w: state.brW, op: state.brOp, style: state.brStyle, c1: state.brC1, c2: state.brC2 };
      localStorage.setItem('suiBorderPresetsV5', JSON.stringify(borderPresets)); updatePresetDropdown(); alert("Saved!");
    }
    function loadBorderPreset() {
      saveHistory(); const p = borderPresets[document.getElementById('br-preset-sel').value]; if(!p) return;
      state.brW = p.w; state.brOp = p.op; state.brStyle = p.style; state.brC1 = p.c1; state.brC2 = p.c2; 
      fullRender(true); pubnub.publish({ channel: 'sui_v5_channel', message: state });
    }
    function deleteBorderPreset() {
      const n = document.getElementById('br-preset-sel').value; if(!n || !confirm(`Delete ${n}?`)) return;
      delete borderPresets[n]; localStorage.setItem('suiBorderPresetsV5', JSON.stringify(borderPresets)); updatePresetDropdown();
    }

    let savedLayouts = {}; let currentLayoutName = "Default";
    function generateBaseLayouts() {
      const b = JSON.parse(initialStateStr); 
      const out = { "Default": JSON.parse(JSON.stringify(b)) };
      
      const sizes = [
        { name: "Small", sf: 0.8 },
        { name: "Regular", sf: 1.0 },
        { name: "Large", sf: 1.25 }
      ];

      const applyScale = (layout, sf) => {
        layout.agScale = sf;
        layout.aglScale = sf;
        layout.clpScale = sf;
        layout.lssScale = sf;
        layout.tgtScale = sf;
        layout.tkH = Math.round(40 * sf);
        layout.tkF = Math.round(22 * sf);
        layout.nameplates.forEach(np => np.scale = sf);
        return layout;
      };

      sizes.forEach(s => {
        // Midnight Blue
        let m = JSON.parse(initialStateStr);
        m.agR1Bg1="#0f172a"; m.agR1Bg2="#1e3a8a"; m.aglC1="#0f172a"; m.aglC2="#1e3a8a"; m.clpC1="#0f172a"; m.clpC2="#1e3a8a"; m.tkC1="#0f172a"; m.tkC2="#1e3a8a"; m.lssC1="#0f172a"; m.lssC2="#1e3a8a"; m.tgtC1="#0f172a"; m.tgtC2="#1e3a8a";
        m.nameplates.forEach(n=>{n.c1="#0f172a"; n.c2="#1e3a8a"; n.titleBg1="#0f172a"; n.titleBg2="#0f172a";});
        out[`Midnight Blue ${s.name}`] = applyScale(m, s.sf);
        
        // Cyberpunk
        let c = JSON.parse(initialStateStr);
        c.ffAg="'Teko', sans-serif"; c.ffTk="'Teko', sans-serif"; c.ffL3="'Teko', sans-serif";
        c.agR1Bg1="#9333ea"; c.agR1Bg2="#db2777"; c.aglC1="#9333ea"; c.aglC2="#db2777"; c.clpC1="#9333ea"; c.clpC2="#db2777"; c.tkC1="#9333ea"; c.tkC2="#db2777"; c.lssC1="#9333ea"; c.lssC2="#db2777"; c.tgtC1="#9333ea"; c.tgtC2="#db2777";
        c.nameplates.forEach(n=>{n.c1="#9333ea"; n.c2="#db2777"; n.titleBg1="#9333ea"; n.titleBg2="#db2777";});
        out[`Cyberpunk ${s.name}`] = applyScale(c, s.sf);

        // Toxic Green
        let tg = JSON.parse(initialStateStr);
        tg.agR1Bg1="#14532d"; tg.agR1Bg2="#22c55e"; tg.aglC1="#14532d"; tg.aglC2="#22c55e"; tg.clpC1="#14532d"; tg.clpC2="#22c55e"; tg.tkC1="#14532d"; tg.tkC2="#22c55e"; tg.lssC1="#14532d"; tg.lssC2="#22c55e"; tg.tgtC1="#14532d"; tg.tgtC2="#22c55e";
        tg.nameplates.forEach(n=>{n.c1="#14532d"; n.c2="#22c55e"; n.titleBg1="#14532d"; n.titleBg2="#22c55e";});
        out[`Toxic Green ${s.name}`] = applyScale(tg, s.sf);

        // Monochrome White
        let min = JSON.parse(initialStateStr);
        min.agR1Style="solid"; min.agR1Bg1="#ffffff"; min.agR1C="#000000"; min.aglStyle="solid"; min.aglC1="#ffffff"; min.aglTxtC="#000000"; min.clpStyle="solid"; min.clpC1="#ffffff"; min.clpTxtC="#000000"; min.tkStyle="solid"; min.tkC1="#ffffff"; min.tkTxtC="#000000"; min.lssStyle="solid"; min.lssC1="#ffffff"; min.lssTxtC="#000000"; min.tgtStyle="solid"; min.tgtC1="#ffffff"; min.tgtC2="#ffffff";
        min.nameplates.forEach(n=>{n.style="solid"; n.c1="#ffffff"; n.txtNameC="#000000"; n.titleStyle="solid"; n.titleBg1="#ffffff"; n.txtTitleC="#000000";});
        out[`Monochrome White ${s.name}`] = applyScale(min, s.sf);

        // Synthwave Multicolor
        let syn = JSON.parse(initialStateStr);
        syn.agR1Bg1="#ff007f"; syn.agR1Bg2="#7928ca"; syn.agB2Bg1="#00f2fe"; syn.agB2Bg2="#4facfe"; syn.agB3Bg1="#f59e0b"; syn.agB3Bg2="#ea580c"; syn.aglC1="#1e3a8a"; syn.aglC2="#9333ea"; syn.clpC1="#1e3a8a"; syn.clpC2="#9333ea"; syn.tkC1="#f59e0b"; syn.tkC2="#ea580c"; syn.lssC1="#10b981"; syn.lssC2="#047857"; syn.tgtC1="#8b5cf6"; syn.tgtC2="#3b82f6";
        syn.nameplates.forEach(n=>{n.c1="#ff007f"; n.c2="#f59e0b"; n.titleBg1="#00f2fe"; n.titleBg2="#4facfe"; n.txtTitleC="#000000";});
        out[`Synthwave Multicolor ${s.name}`] = applyScale(syn, s.sf);
        
        // SUI Core (Red & Gold)
        let sui = JSON.parse(initialStateStr);
        out[`SUI Core ${s.name}`] = applyScale(sui, s.sf);
      });

      return out;
    }
    
    function initLayouts() {
      initialStateStr = JSON.stringify(state);
      
      const stored = localStorage.getItem('suiDiscLayoutsV5');
      if(stored) savedLayouts = JSON.parse(stored); 
      else { 
        savedLayouts = generateBaseLayouts(); 
        localStorage.setItem('suiDiscLayoutsV5', JSON.stringify(savedLayouts)); 
      }
      
      const last = localStorage.getItem('suiLastDiscLayoutV5');
      if(last && savedLayouts[last]) executeLoad(last); else executeLoad("Default");
    }
    
    function saveLayout() { 
      document.getElementById('modal-bg').style.display = 'block'; 
      document.getElementById('save-warning-modal').style.display = 'block'; 
    }

    function confirmSaveLayout() {
      savedLayouts[currentLayoutName] = JSON.parse(JSON.stringify(state)); 
      localStorage.setItem('suiDiscLayoutsV5', JSON.stringify(savedLayouts)); 
      closeModals();
      alert("Layout Saved!"); 
    }

    function saveLayoutAs() {
      const n = prompt("Layout Name:", "My Set"); if(!n) return;
      currentLayoutName = n.trim(); savedLayouts[currentLayoutName] = JSON.parse(JSON.stringify(state));
      localStorage.setItem('suiDiscLayoutsV5', JSON.stringify(savedLayouts)); localStorage.setItem('suiLastDiscLayoutV5', currentLayoutName);
      document.getElementById('current-layout-badge').textContent = `Layout: ${currentLayoutName}`; alert("Saved as: " + currentLayoutName);
    }

    function executeLoad(name) {
      if(!savedLayouts[name]) return;
      saveHistory(); currentLayoutName = name; localStorage.setItem('suiLastDiscLayoutV5', name);
      if(!isOverlay) document.getElementById('current-layout-badge').textContent = `Layout: ${name}`;
      
      const loaded = JSON.parse(JSON.stringify(savedLayouts[name]));
      
      // Preserve existing content and visibilities, apply ONLY styles from preset
      const newState = { ...state };
      
      const styleKeys = [
        'agScale', 'ffAg', 'agR1F', 'agR1C', 'agR1Style', 'agR1Bg1', 'agR1Bg2',
        'agR2F', 'agR2C', 'agR2Style', 'agR2Bg1', 'agR2Bg2', 'agB2C', 'agB2Style', 'agB2Bg1', 'agB2Bg2',
        'agR3F', 'agR3C', 'agR3Style', 'agR3Bg1', 'agR3Bg2', 'agB3C', 'agB3Style', 'agB3Bg1', 'agB3Bg2',
        'aglScale', 'aglTxtC', 'aglStyle', 'aglC1', 'aglC2',
        'clpScale', 'clpTxtC', 'clpStyle', 'clpC1', 'clpC2', 
        'ffL3', 'l3FName', 'l3FTitle', 
        'lssScale', 'lssTxtC', 'lssStyle', 'lssC1', 'lssC2',
        'ffTk', 'tkF', 'tkTxtC', 'tkH', 'tkOp', 'tkStyle', 'tkC1', 'tkC2',
        'brW', 'brOp', 'brStyle', 'brC1', 'brC2',
        'tgtScale', 'ffTgtLbl', 'fTgtLbl', 'ffTgtVal', 'fTgtVal', 'tgtStyle', 'tgtC1', 'tgtC2'
      ];
      
      styleKeys.forEach(k => { if(loaded[k] !== undefined) newState[k] = loaded[k]; });

      if (loaded.nameplates && loaded.nameplates.length > 0 && newState.nameplates.length > 0) {
        const pStyle = loaded.nameplates[0];
        newState.nameplates = newState.nameplates.map(np => ({
          ...np, scale: pStyle.scale, style: pStyle.style, c1: pStyle.c1, c2: pStyle.c2, txtNameC: pStyle.txtNameC, txtTitleC: pStyle.txtTitleC, titleStyle: pStyle.titleStyle, titleBg1: pStyle.titleBg1, titleBg2: pStyle.titleBg2
        }));
      }

      state = newState;
      fullRender(true); closeModals();
    }
    
    function renderLayoutList() { document.getElementById('layout-list').innerHTML = Object.keys(savedLayouts).map(n => `<div class="list-item-row"><span>${n}</span> <button class="ctrl-btn highlight" onclick="executeLoad('${n}')">Load</button></div>`).join(''); }

    if(!isOverlay) { initBorderPresets(); initLayouts(); }
  </script>
</body>
</html>
