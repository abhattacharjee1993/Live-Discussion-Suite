  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const isOverlay = urlParams.get('view') === 'overlay';
    if (isOverlay) { document.getElementById('controls').style.display = 'none'; document.getElementById('drag-hint').style.display = 'none'; }

    // Set Default Dropdowns
    document.getElementById('ff-ag').value = "'Montserrat', sans-serif";
    document.getElementById('ff-l3').value = "'Montserrat', sans-serif";
    document.getElementById('ff-tk').value = "'Montserrat', sans-serif";
    document.getElementById('ff-tgt-lbl').value = "'Montserrat', sans-serif";
    document.getElementById('ff-tgt-val').value = "'Teko', sans-serif";

    // History Engine
    let undoStack = [];
    let redoStack = [];
    let initialStateStr = null;

    function saveHistory() {
      undoStack.push(JSON.parse(JSON.stringify(state)));
      redoStack = [];
      if(undoStack.length > 50) undoStack.shift();
    }
    function undo() {
      if(undoStack.length === 0) return;
      redoStack.push(JSON.parse(JSON.stringify(state)));
      state = undoStack.pop();
      fullRender(true); syncVisuals();
    }
    function redo() {
      if(redoStack.length === 0) return;
      undoStack.push(JSON.parse(JSON.stringify(state)));
      state = redoStack.pop();
      fullRender(true); syncVisuals();
    }
    function reset() {
      saveHistory();
      state = JSON.parse(initialStateStr);
      fullRender(true); syncVisuals();
    }

    if(!isOverlay) {
      document.getElementById('controls').addEventListener('change', (e) => {
        if(e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT') return;
        saveHistory(); 
      });
    }

    // Modals
    function openLayoutModal() { document.getElementById('modal-bg').style.display = 'block'; document.getElementById('layout-modal').style.display = 'block'; renderLayoutList(); }
    function openManual() { document.getElementById('modal-bg').style.display = 'block'; document.getElementById('manual-modal').style.display = 'block'; }
    function closeModals() { document.getElementById('modal-bg').style.display = 'none'; document.getElementById('layout-modal').style.display = 'none'; document.getElementById('manual-modal').style.display = 'none'; document.getElementById('save-warning-modal').style.display = 'none'; }

