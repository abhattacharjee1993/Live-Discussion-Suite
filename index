    .controller-panel { position: absolute; top: 60px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; background: rgba(16, 20, 26, 0.95); padding: 20px; border-radius: 12px; border: 2px solid #333; width: 1150px; color: #fff; max-height: calc(100vh - 80px); z-index: 1000; box-shadow: 0 20px 50px rgba(0,0,0,0.9); transition: width 0.3s ease; }
    .controls-body { overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 8px; }
