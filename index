    function initBorderPresets() {
      const stored = localStorage.getItem('suiBorderPresetsV5');
      borderPresets = stored ? JSON.parse(stored) : defaultBorderPresets;
      updatePresetDropdown();
    }
    function updatePresetDropdown() {
      const sel = document.getElementById('br-preset-sel'); sel.innerHTML = '<option value="">Presets...</option>';
      Object.keys(borderPresets).forEach(k => { sel.innerHTML += `<option value="${k}">${k}</option>`; });
    }
    function saveBorderPreset() {
      const name = prompt("Name this preset:"); if(!name) return;
      borderPresets[name] = { w: state.brW, op: state.brOp, style: state.brStyle, c1: state.brC1, c2: state.brC2 };
      localStorage.setItem('suiBorderPresetsV5', JSON.stringify(borderPresets)); updatePresetDropdown(); alert("Saved!");
    }
    function loadBorderPreset() {
      saveHistory(); const p = borderPresets[document.getElementById('br-preset-sel').value]; if(!p) return;
      state.brW = p.w; state.brOp = p.op; state.brStyle = p.style; state.brC1 = p.c1; state.brC2 = p.c2; 
      fullRender(true); pubnub.publish({ channel: 'sui_v5_channel', message: state });
    }
    function deleteBorderPreset() {
      const n = document.getElementById('br-preset-sel').value; if(!n || !confirm(`Delete ${n}?`)) return;
      delete borderPresets[n]; localStorage.setItem('suiBorderPresetsV5', JSON.stringify(borderPresets)); updatePresetDropdown();
    }

    let savedLayouts = {}; let currentLayoutName = "Default";
    function generateBaseLayouts() {
      const b = JSON.parse(initialStateStr); 
      const out = { "Default": JSON.parse(JSON.stringify(b)) };
      
      const sizes = [
        { name: "Small", sf: 0.8 },
        { name: "Regular", sf: 1.0 },
        { name: "Large", sf: 1.25 }
      ];

      const applyScale = (layout, sf) => {
        layout.agScale = sf;
        layout.aglScale = sf;
        layout.clpScale = sf;
        layout.lssScale = sf;
        layout.tgtScale = sf;
        layout.tkH = Math.round(40 * sf);
        layout.tkF = Math.round(22 * sf);
        layout.nameplates.forEach(np => np.scale = sf);
        return layout;
      };

      sizes.forEach(s => {
        // Midnight Blue
        let m = JSON.parse(initialStateStr);
        m.agR1Bg1="#0f172a"; m.agR1Bg2="#1e3a8a"; m.aglC1="#0f172a"; m.aglC2="#1e3a8a"; m.clpC1="#0f172a"; m.clpC2="#1e3a8a"; m.tkC1="#0f172a"; m.tkC2="#1e3a8a"; m.lssC1="#0f172a"; m.lssC2="#1e3a8a"; m.tgtC1="#0f172a"; m.tgtC2="#1e3a8a";
        m.nameplates.forEach(n=>{n.c1="#0f172a"; n.c2="#1e3a8a"; n.titleBg1="#0f172a"; n.titleBg2="#0f172a";});
        out[`Midnight Blue ${s.name}`] = applyScale(m, s.sf);
        
        // Cyberpunk
        let c = JSON.parse(initialStateStr);
        c.ffAg="'Teko', sans-serif"; c.ffTk="'Teko', sans-serif"; c.ffL3="'Teko', sans-serif";
        c.agR1Bg1="#9333ea"; c.agR1Bg2="#db2777"; c.aglC1="#9333ea"; c.aglC2="#db2777"; c.clpC1="#9333ea"; c.clpC2="#db2777"; c.tkC1="#9333ea"; c.tkC2="#db2777"; c.lssC1="#9333ea"; c.lssC2="#db2777"; c.tgtC1="#9333ea"; c.tgtC2="#db2777";
        c.nameplates.forEach(n=>{n.c1="#9333ea"; n.c2="#db2777"; n.titleBg1="#9333ea"; n.titleBg2="#db2777";});
        out[`Cyberpunk ${s.name}`] = applyScale(c, s.sf);

        // Toxic Green
        let tg = JSON.parse(initialStateStr);
        tg.agR1Bg1="#14532d"; tg.agR1Bg2="#22c55e"; tg.aglC1="#14532d"; tg.aglC2="#22c55e"; tg.clpC1="#14532d"; tg.clpC2="#22c55e"; tg.tkC1="#14532d"; tg.tkC2="#22c55e"; tg.lssC1="#14532d"; tg.lssC2="#22c55e"; tg.tgtC1="#14532d"; tg.tgtC2="#22c55e";
        tg.nameplates.forEach(n=>{n.c1="#14532d"; n.c2="#22c55e"; n.titleBg1="#14532d"; n.titleBg2="#22c55e";});
        out[`Toxic Green ${s.name}`] = applyScale(tg, s.sf);

        // Monochrome White
        let min = JSON.parse(initialStateStr);
        min.agR1Style="solid"; min.agR1Bg1="#ffffff"; min.agR1C="#000000"; min.aglStyle="solid"; min.aglC1="#ffffff"; min.aglTxtC="#000000"; min.clpStyle="solid"; min.clpC1="#ffffff"; min.clpTxtC="#000000"; min.tkStyle="solid"; min.tkC1="#ffffff"; min.tkTxtC="#000000"; min.lssStyle="solid"; min.lssC1="#ffffff"; min.lssTxtC="#000000"; min.tgtStyle="solid"; min.tgtC1="#ffffff"; min.tgtC2="#ffffff";
        min.nameplates.forEach(n=>{n.style="solid"; n.c1="#ffffff"; n.txtNameC="#000000"; n.titleStyle="solid"; n.titleBg1="#ffffff"; n.txtTitleC="#000000";});
        out[`Monochrome White ${s.name}`] = applyScale(min, s.sf);

        // Synthwave Multicolor
        let syn = JSON.parse(initialStateStr);
        syn.agR1Bg1="#ff007f"; syn.agR1Bg2="#7928ca"; syn.agB2Bg1="#00f2fe"; syn.agB2Bg2="#4facfe"; syn.agB3Bg1="#f59e0b"; syn.agB3Bg2="#ea580c"; syn.aglC1="#1e3a8a"; syn.aglC2="#9333ea"; syn.clpC1="#1e3a8a"; syn.clpC2="#9333ea"; syn.tkC1="#f59e0b"; syn.tkC2="#ea580c"; syn.lssC1="#10b981"; syn.lssC2="#047857"; syn.tgtC1="#8b5cf6"; syn.tgtC2="#3b82f6";
        syn.nameplates.forEach(n=>{n.c1="#ff007f"; n.c2="#f59e0b"; n.titleBg1="#00f2fe"; n.titleBg2="#4facfe"; n.txtTitleC="#000000";});
        out[`Synthwave Multicolor ${s.name}`] = applyScale(syn, s.sf);
        
        // SUI Core (Red & Gold)
        let sui = JSON.parse(initialStateStr);
        out[`SUI Core ${s.name}`] = applyScale(sui, s.sf);
      });

      return out;
    }
    
    function initLayouts() {
      initialStateStr = JSON.stringify(state);
      
      const stored = localStorage.getItem('suiDiscLayoutsV5');
      if(stored) savedLayouts = JSON.parse(stored); 
      else { 
        savedLayouts = generateBaseLayouts(); 
        localStorage.setItem('suiDiscLayoutsV5', JSON.stringify(savedLayouts)); 
      }
      
      const last = localStorage.getItem('suiLastDiscLayoutV5');
      if(last && savedLayouts[last]) executeLoad(last); else executeLoad("Default");
    }
    
    function saveLayout() { 
      document.getElementById('modal-bg').style.display = 'block'; 
      document.getElementById('save-warning-modal').style.display = 'block'; 
    }

    function confirmSaveLayout() {
      savedLayouts[currentLayoutName] = JSON.parse(JSON.stringify(state)); 
      localStorage.setItem('suiDiscLayoutsV5', JSON.stringify(savedLayouts)); 
      closeModals();
      alert("Layout Saved!"); 
    }

    function saveLayoutAs() {
      const n = prompt("Layout Name:", "My Set"); if(!n) return;
      currentLayoutName = n.trim(); savedLayouts[currentLayoutName] = JSON.parse(JSON.stringify(state));
      localStorage.setItem('suiDiscLayoutsV5', JSON.stringify(savedLayouts)); localStorage.setItem('suiLastDiscLayoutV5', currentLayoutName);
      document.getElementById('current-layout-badge').textContent = `Layout: ${currentLayoutName}`; alert("Saved as: " + currentLayoutName);
    }

    function executeLoad(name) {
      if(!savedLayouts[name]) return;
      saveHistory(); currentLayoutName = name; localStorage.setItem('suiLastDiscLayoutV5', name);
      if(!isOverlay) document.getElementById('current-layout-badge').textContent = `Layout: ${name}`;
      
      const loaded = JSON.parse(JSON.stringify(savedLayouts[name]));
      
      // Preserve existing content and visibilities, apply ONLY styles from preset
      const newState = { ...state };
      
      const styleKeys = [
        'agScale', 'ffAg', 'agR1F', 'agR1C', 'agR1Style', 'agR1Bg1', 'agR1Bg2',
        'agR2F', 'agR2C', 'agR2Style', 'agR2Bg1', 'agR2Bg2', 'agB2C', 'agB2Style', 'agB2Bg1', 'agB2Bg2',
        'agR3F', 'agR3C', 'agR3Style', 'agR3Bg1', 'agR3Bg2', 'agB3C', 'agB3Style', 'agB3Bg1', 'agB3Bg2',
        'aglScale', 'aglTxtC', 'aglStyle', 'aglC1', 'aglC2',
        'clpScale', 'clpTxtC', 'clpStyle', 'clpC1', 'clpC2', 
        'ffL3', 'l3FName', 'l3FTitle', 
        'lssScale', 'lssTxtC', 'lssStyle', 'lssC1', 'lssC2',
        'ffTk', 'tkF', 'tkTxtC', 'tkH', 'tkOp', 'tkStyle', 'tkC1', 'tkC2',
        'brW', 'brOp', 'brStyle', 'brC1', 'brC2',
        'tgtScale', 'ffTgtLbl', 'fTgtLbl', 'ffTgtVal', 'fTgtVal', 'tgtStyle', 'tgtC1', 'tgtC2'
      ];
      
      styleKeys.forEach(k => { if(loaded[k] !== undefined) newState[k] = loaded[k]; });

      if (loaded.nameplates && loaded.nameplates.length > 0 && newState.nameplates.length > 0) {
        const pStyle = loaded.nameplates[0];
        newState.nameplates = newState.nameplates.map(np => ({
          ...np, scale: pStyle.scale, style: pStyle.style, c1: pStyle.c1, c2: pStyle.c2, txtNameC: pStyle.txtNameC, txtTitleC: pStyle.txtTitleC, titleStyle: pStyle.titleStyle, titleBg1: pStyle.titleBg1, titleBg2: pStyle.titleBg2
        }));
      }

      state = newState;
      fullRender(true); closeModals();
    }
    
    function renderLayoutList() { document.getElementById('layout-list').innerHTML = Object.keys(savedLayouts).map(n => `<div class="list-item-row"><span>${n}</span> <button class="ctrl-btn highlight" onclick="executeLoad('${n}')">Load</button></div>`).join(''); }

    if(!isOverlay) { initBorderPresets(); initLayouts(); }
  </script>
