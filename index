    .sub-count-wrapper iframe { width: 100%; height: 100%; border: none; overflow: hidden; }
    .targets-wrapper { position: absolute; right: 20px; top: 20px; height: 100px; border-radius: 8px; border: 2px solid rgba(255, 255, 255, 0.25); z-index: 5; box-shadow: 0 8px 24px rgba(0,0,0,0.85); display: flex; flex-direction: column; justify-content: center; padding: 0 24px; gap: 12px; min-width: 260px; transform: scale(var(--target-scale)); transform-origin: top right; transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
