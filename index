    // --- PRESETS & LAYOUTS ---
    let borderPresets = {};
    const defaultBorderPresets = {
      'East Bengal Split': { w:8, op:1, style:'split', c1:'#d31122', c2:'#f6b200' },
      'Cyber Gradient': { w:12, op:1, style:'gradient', c1:'#06b6d4', c2:'#9333ea' },
      'Solid White Thin': { w:4, op:0.8, style:'solid', c1:'#ffffff', c2:'#ffffff' },
      'Neon Blue': { w:8, op:1, style:'gradient', c1:'#00f2fe', c2:'#4facfe' },
      'Crimson Force': { w:10, op:1, style:'split', c1:'#ff0844', c2:'#ffb199' },
      'Emerald Outline': { w:6, op:0.9, style:'solid', c1:'#10b981', c2:'#10b981' },
      'Royal Purple': { w:12, op:1, style:'gradient', c1:'#667eea', c2:'#764ba2' },
      'Sunset Orange': { w:8, op:1, style:'gradient', c1:'#ff9a9e', c2:'#fecfef' },
