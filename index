    .ctrl-master-header:active { cursor: grabbing; }
    .layout-name-badge { background: #333; padding: 4px 10px; border-radius: 4px; font-size: 12px; color: #aaa; margin-left: 10px; font-weight: bold; pointer-events: none; }
    .collapsible-header { background: #1e242d; color: #fff; padding: 14px 18px; cursor: pointer; font-weight: 800; font-family: 'Montserrat', sans-serif; letter-spacing: 1px; border: 1px solid #444; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; text-transform: uppercase; margin-bottom: 4px; transition: background 0.2s; }
    .collapsible-header:hover { background: #2a323d; }
    .collapsible-content { display: none; padding: 20px; background: rgba(0, 0, 0, 0.2); border: 1px solid #444; border-top: none; border-radius: 0 0 6px 6px; flex-direction: column; gap: 16px; margin-top: -8px; margin-bottom: 12px; }
    .collapsible-content.active { display: flex; }
    .ctrl-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-start; align-items: center; }
    .sub-panel { background: rgba(0,0,0,0.4); padding: 16px; border-radius: 8px; border: 1px solid #333; margin-bottom: 12px; width: 100%; }
    .ctrl-btn { background: #2b323c; color: #eee; border: 1px solid #555; padding: 8px 16px; font-size: 13px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: background 0.2s, transform 0.1s; }
    .ctrl-btn:hover { background: #3b4451; }
    .ctrl-btn.highlight { background: #1a4d2e; border-color: #277144; color: #fff; }
    .ctrl-btn.warning { background: #8a2b2b; border-color: #a63a3a; color: #fff; }
    .ctrl-btn.special { background: #2563eb; border-color: #1d4ed8; color: #fff; }
    .ctrl-btn.sync-btn { background: #eab308; border-color: #ca8a04; color: #000; font-size: 15px; padding: 10px 24px; box-shadow: 0 4px 10px rgba(234, 179, 8, 0.3); }
    .slider-group { display: flex; gap: 20px; flex-wrap: wrap; justify-content: flex-start; }
    .slider-container { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 11px; color: #ccc; font-weight: bold; text-transform: uppercase; }
    .slider-container input[type="range"] { width: 80px; cursor: pointer; accent-color: #eab308; }
    .slider-container input[type="color"] { border: 1px solid #555; border-radius: 4px; width: 34px; height: 34px; cursor: pointer; background: #222; padding:0; }
    input.auto-text { padding: 8px 12px; border-radius: 4px; border: 1px solid #555; background: #222; color: #fff; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 14px; width: 100%; }
    input.auto-text:focus { outline: 2px solid #eab308; border-color: transparent; }
    .section-title { font-size: 13px; color: #ffd700; font-weight: 800; text-transform: uppercase; width: 100%; text-align: left; margin-bottom: 8px; letter-spacing: 1px; display: block; border-bottom: 1px solid #444; padding-bottom: 6px; }

    /* Drag Hint Overlay */
    #drag-hint { position: absolute; left: 50%; top: 10%; transform: translateX(-50%); background: rgba(234, 179, 8, 0.9); color: #000; padding: 10px 20px; border-radius: 20px; font-size: 14px; font-weight: 900; display: none; pointer-events: none; z-index: 10000; box-shadow: 0 5px 15px rgba(0,0,0,0.5); text-transform: uppercase; }

    /* Modals */
    .modal-bg { display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 9999; }
