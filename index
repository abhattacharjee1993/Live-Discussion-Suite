        document.getElementById('tk-vis').checked = state.tkVis; document.getElementById('tk-scroll').checked = state.tkScroll; document.getElementById('tk-txt').value = state.tkTxt;
        document.getElementById('ff-tk').value = state.ffTk; document.getElementById('tk-f').value = state.tkF; document.getElementById('tk-txt-c').value = state.tkTxtC; document.getElementById('tk-h').value = state.tkH; document.getElementById('tk-op').value = state.tkOp; document.getElementById('tk-style').value = state.tkStyle; document.getElementById('tk-c1').value = state.tkC1; document.getElementById('tk-c2').value = state.tkC2;

